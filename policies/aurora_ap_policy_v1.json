      "candidate_actions": ["inspect_invoice_fields"]
    },
    "invoice_calculation_valid": {"proof_template": "semantic_gate", "target_predicate": "invoice.calculation_valid", "capability": "document_semantics", "activation": "explicit", "inputs": [{"subject": "invoice", "predicate": "calculation_trace", "role": "invoice", "hole_kind": "claim", "value_type": "string"}], "candidate_actions": ["inspect_invoice_calculation"]},
    "three_way_quantity_match": {
