    "quantity_matching_tolerance",
    "contract_matching_tolerance",
    "duplicate_search_window",
    "approval_authority_limits",
    "bank_change_cooling_period",
    "payment_release_thresholds",
    "jurisdiction_tax_rules",
    "record_retention_period"
