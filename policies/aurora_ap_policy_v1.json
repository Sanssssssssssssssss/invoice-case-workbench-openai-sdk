    "vendor_identity_active": {
      "proof_template": "semantic_gate", "target_predicate": "vendor.identity_active", "capability": "master_data_status", "activation": "explicit",
      "inputs": [
        {"subject": "vendor", "predicate": "identity", "role": "vendor_identity", "hole_kind": "relation", "value_type": "string", "binding_mode": "same_entity", "binding_group": "vendor"},
