  "contract_version": "aurora_proof_contracts_v2",
  "proof_contracts": {
    "three_way_amount_match": {
      "proof_template": "reconciliation", "target_predicate": "payable.three_way_amount_match", "capability": "amount_reconciliation", "activation": "derived",
      "activation_requirement_groups": [["invoice"], ["purchase_order"], ["goods_receipt", "goods_receipt_or_service_acceptance"]],
      "inputs": [
        {"subject": "invoice", "predicate": "amount", "role": "invoice", "hole_kind": "claim", "value_type": "decimal", "required_attributes": ["currency", "basis", "tax_basis", "coverage"]},
        {"subject": "purchase_order", "predicate": "amount", "role": "purchase_order", "hole_kind": "claim", "value_type": "decimal", "required_attributes": ["currency", "basis", "tax_basis", "coverage"]},
        {"subject": "goods_receipt", "predicate": "amount", "role": "goods_receipt_or_service_acceptance", "hole_kind": "claim", "value_type": "decimal", "required_attributes": ["currency", "basis", "tax_basis", "coverage"]},
        {"subject": "invoice", "predicate": "order_scope_identity", "role": "invoice", "hole_kind": "relation", "value_type": "string"},
        {"subject": "purchase_order", "predicate": "order_scope_identity", "role": "purchase_order", "hole_kind": "relation", "value_type": "string"},
        {"subject": "goods_receipt", "predicate": "order_scope_identity", "role": "goods_receipt_or_service_acceptance", "hole_kind": "relation", "value_type": "string"},
        {"subject": "payable", "predicate": "amount_scope_comparable", "role": "three_way_amount_match", "hole_kind": "judgment"}
      ],
      "candidate_actions": ["inspect_amount_basis", "request_missing_amount_source"]
    },
    "no_active_duplicate": {
      "proof_template": "entity_lifecycle", "target_predicate": "payable.no_active_duplicate", "capability": "payment_lifecycle", "activation": "derived",
      "activation_requirement_groups": [["invoice"], ["duplicate_payment_check", "duplicate_payment_screen"]],
      "inputs": [
        {"subject": "invoice", "predicate": "payable_identity", "role": "invoice", "hole_kind": "relation", "value_type": "string"},
        {"subject": "duplicate_search", "predicate": "payable_identity", "role": "duplicate_payment_screen", "hole_kind": "relation", "value_type": "string"},
        {"subject": "duplicate_search", "predicate": "coverage", "role": "duplicate_payment_screen", "hole_kind": "claim", "value_type": "enum", "allowed_values": ["complete", "partial", "unknown"]},
        {"subject": "duplicate_search", "predicate": "result", "role": "duplicate_payment_screen", "hole_kind": "claim", "value_type": "enum", "allowed_values": ["no_candidate", "candidate_found", "unknown"]},
        {"subject": "duplicate_search", "predicate": "candidate_identity", "role": "duplicate_payment_screen", "hole_kind": "relation", "value_type": "string", "required": false, "binding_mode": "per_entity", "binding_group": "duplicate_candidate", "group_required": true},
        {"subject": "payment", "predicate": "identity", "role": "duplicate_payment_screen", "hole_kind": "relation", "value_type": "string", "required": false, "binding_mode": "per_entity", "binding_group": "duplicate_candidate", "group_required": true},
        {"subject": "payment", "predicate": "relationship_to_payable", "role": "duplicate_payment_screen", "hole_kind": "claim", "value_type": "enum", "allowed_values": ["same_obligation", "different_obligation", "unknown"], "required": false, "binding_mode": "per_entity", "binding_group": "duplicate_candidate", "group_required": true},
        {"subject": "payment", "predicate": "economic_effect", "role": "duplicate_payment_screen", "hole_kind": "claim", "value_type": "enum", "allowed_values": ["neutralized_by_reversal", "active_settled", "unknown"], "required": false, "binding_mode": "per_entity", "binding_group": "duplicate_candidate", "group_required": true},
        {"subject": "reversal", "predicate": "reverses", "role": "duplicate_payment_screen", "hole_kind": "relation", "value_type": "string", "required": false, "binding_mode": "per_entity", "binding_group": "duplicate_candidate"},
        {"subject": "reversal", "predicate": "posting_status", "role": "duplicate_payment_screen", "hole_kind": "claim", "value_type": "enum", "allowed_values": ["posted", "draft", "voided", "unknown"], "required": false, "binding_mode": "per_entity", "binding_group": "duplicate_candidate"},
        {"subject": "reversal", "predicate": "scope", "role": "duplicate_payment_screen", "hole_kind": "claim", "value_type": "enum", "allowed_values": ["full", "partial", "unknown"], "required": false, "binding_mode": "per_entity", "binding_group": "duplicate_candidate"},
        {"subject": "payable", "predicate": "no_active_duplicate_lifecycle", "role": "no_active_duplicate", "hole_kind": "judgment"}
      ],
      "candidate_actions": ["inspect_duplicate_candidates", "request_complete_payment_search"]
    },
    "invoice_fields_valid": {
      "proof_template": "semantic_gate", "target_predicate": "invoice.fields_valid", "capability": "document_semantics", "activation": "explicit",
