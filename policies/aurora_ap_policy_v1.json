  "comparable_tax_bases": ["gross", "net"],
  "comparable_coverages": ["full"],
  "amount_match_requirement": "three_way_amount_match",
  "semantic_judgment_min_confidence": "high",
  "unconfigured_policy_values": [
    "invoice_calculation_rounding_tolerance",
    "quantity_matching_tolerance",
    "duplicate_search_window",
    "approval_authority_limits",
    "bank_change_cooling_period",
    "payment_release_thresholds",
    "jurisdiction_tax_rules",
    "record_retention_period"
