# Copy to backend/.env only if you do not want to use INVOICE_AGENT_ENV_FILE or the legacy env file.
# The app can auto-load E:\GPTProject2\ERPagent\rfp-security-rag\backend\.env when present for model credentials.

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.1

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

INVOICE_AGENT_WORKSPACE_ROOT=workspace/cases
INVOICE_AGENT_STORAGE_ROOT=backend/storage
INVOICE_AGENT_SESSION_DB=backend/storage/sessions.sqlite
INVOICE_AGENT_MEMORY_DB=backend/storage/memory.sqlite
INVOICE_AGENT_KNOWLEDGE_ROOTS=knowledge/invoice_payment
# Set to true only when you explicitly want to add the old local knowledge folder as a compatibility source.
INVOICE_AGENT_INCLUDE_LEGACY_KNOWLEDGE=false
# Harness writes local traces under workspace/cases/{case_id}/traces. LangSmith is opt-in.
INVOICE_AGENT_ENABLE_LANGSMITH=false
INVOICE_AGENT_ENABLE_LANGFUSE=false
INVOICE_AGENT_LANGFUSE_CAPTURE_PAYLOADS=summary
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional manual cost calculation for providers/models missing from Langfuse pricing.
INVOICE_AGENT_LLM_INPUT_COST_PER_1M=0
INVOICE_AGENT_LLM_OUTPUT_COST_PER_1M=0
INVOICE_AGENT_LLM_CACHED_INPUT_COST_PER_1M=0
INVOICE_AGENT_MAX_STEPS=10
INVOICE_AGENT_CONTEXT_CHAR_LIMIT=200000

# Local document extraction for PDF/image attachments.
# Leave TESSERACT_CMD empty to use PATH or the common Windows install path.
INVOICE_AGENT_TESSERACT_CMD=
INVOICE_AGENT_OCR_LANGS=eng
INVOICE_AGENT_PDF_MAX_PAGES=5
INVOICE_AGENT_OCR_DPI=200
INVOICE_AGENT_PDF_MIN_TEXT_CHARS=80
INVOICE_AGENT_DOCLING_ENABLED=true
INVOICE_AGENT_PADDLEOCR_ENABLED=true
