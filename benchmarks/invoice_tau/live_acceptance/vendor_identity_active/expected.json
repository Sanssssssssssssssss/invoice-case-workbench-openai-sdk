{
  "case_status": "ready_for_report",
  "min_evidence_count": 1,
  "reply_any_of": ["供应商", "有效", "启用", "active"],
  "requirements": {
    "vendor_identity": "accepted",
    "vendor_identity_active": "satisfied"
  },
  "proof_requirement_id": "vendor_identity_active",
  "decision_status": "SUPPORTED",
  "proof_min_source_count": 1,
  "proof_has_blocking_obligations": false,
  "must_have_evidence_types": ["vendor_record"],
  "trace_must_call": ["read_attachment", "evidence_reviewer", "case_patch_writer", "write_case_patch"],
  "trace_must_not_call": ["materials_advisor", "report_writer", "write_case_file", "render_pdf"],
  "artifacts_must_not_exist": ["reports/*.md", "reports/*.pdf"],
  "budgets": {"max_model_calls": 5, "max_tool_calls": 2, "max_role_calls": 2, "max_wall_time_ms": 700000}
}
