  "dynamic_support_requirements": [
    "invoice_number", "supplier", "buyer", "invoice_date", "amount_total", "currency_tax", "currency", "tax_treatment", "source_traceability",
    "line_items_product_title", "signature_or_authorized_signatory", "template_match",
    "po_number", "po_ref", "po_amount", "po_date", "grn_number", "received_quantity", "inspection_status",
    "vendor_status", "vendor_id", "bank_last_four", "duplicate_invoice_found", "prior_payment_found", "clearing_document", "payment_reference",
